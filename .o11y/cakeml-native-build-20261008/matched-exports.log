KERNEL_THEOREM typeSysProps.type_op_cases
⊢ type_op op ts t3 ⇔
  (∃a ty.
     op = Arith a ty ∧ EVERY (λarg. arg = t_of ty) ts ∧ t3 = t_of ty ∧
     supported_arith a ty = SOME (LENGTH ts)) ∨
