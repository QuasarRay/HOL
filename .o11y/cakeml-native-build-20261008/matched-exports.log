KERNEL_THEOREM semanticPrimitivesProps.FV_def
⊢ (∀e. FV (Raise e) = FV e) ∧
  (∀pes e. FV (Handle e pes) = FV e ∪ FV_pes pes) ∧ (∀v0. FV (Lit v0) = ∅) ∧
  (∀v1 ls. FV (Con v1 ls) = FV_list ls) ∧ (∀id. FV (Var id) = {id}) ∧
  (∀x e. FV (Fun x e) = FV e DIFF {Short x}) ∧
  (∀v2 es. FV (App v2 es) = FV_list es) ∧
  (∀v3 e2 e1. FV (Log v3 e1 e2) = FV e1 ∪ FV e2) ∧
  (∀e3 e2 e1. FV (If e1 e2 e3) = FV e1 ∪ FV e2 ∪ FV e3) ∧
  (∀pes e. FV (Mat e pes) = FV e ∪ FV_pes pes) ∧
  (∀xo e b.
     FV (Let xo e b) =
     FV e ∪ (FV b DIFF case xo of NONE => ∅ | SOME x => {Short x})) ∧
  (∀defs b.
     FV (Letrec defs b) =
     FV_defs defs ∪ FV b DIFF set (MAP (Short ∘ FST) defs)) ∧
  (∀t e. FV (Tannot e t) = FV e) ∧ (∀l e. FV (Lannot e l) = FV e) ∧
  FV_list [] = ∅ ∧ (∀es e. FV_list (e::es) = FV e ∪ FV_list es) ∧
  FV_pes [] = ∅ ∧
  (∀pes p e.
     FV_pes ((p,e)::pes) =
     FV e DIFF IMAGE Short (set (pat_bindings p [])) ∪ FV_pes pes) ∧
  FV_defs [] = ∅ ∧
  ∀x v4 e defs. FV_defs ((v4,x,e)::defs) = FV e DIFF {Short x} ∪ FV_defs defs
