KERNEL_THEOREM evaluateProps.evaluate_decs_clock_determ
⊢ ∀s e p s1 r1 s2 r2 k1 k2.
    evaluate_decs (s with clock := k1) e p = (s1,r1) ∧
    evaluate_decs (s with clock := k2) e p = (s2,r2) ⇒
    case (r1,r2) of
      (Rval v12,Rval v8) => s1.ffi = s2.ffi ∧ r1 = r2
    | (Rerr (Rraise v16),Rval v8) => s1.ffi = s2.ffi ∧ r1 = r2
    | (Rerr (Rabort Rtype_error),Rval v8) => s1.ffi = s2.ffi ∧ r1 = r2
    | (Rerr (Rabort Rtimeout_error),Rval v8) => k1 < k2
    | (Rerr (Rabort (Rffi_error v19)),Rval v8) => s1.ffi = s2.ffi ∧ r1 = r2
    | (Rval v24,Rerr (Rraise v28)) => s1.ffi = s2.ffi ∧ r1 = r2
    | (Rval v24,Rerr (Rabort Rtype_error)) => s1.ffi = s2.ffi ∧ r1 = r2
    | (Rval v24,Rerr (Rabort Rtimeout_error)) => k2 < k1
    | (Rval v24,Rerr (Rabort (Rffi_error v31))) => s1.ffi = s2.ffi ∧ r1 = r2
    | (Rerr (Rraise v40),Rerr (Rraise v36)) => s1.ffi = s2.ffi ∧ r1 = r2
    | (Rerr (Rabort Rtype_error),Rerr (Rraise v36)) =>
      s1.ffi = s2.ffi ∧ r1 = r2
    | (Rerr (Rabort Rtimeout_error),Rerr (Rraise v36)) => k1 < k2
    | (Rerr (Rabort (Rffi_error v43)),Rerr (Rraise v36)) =>
      s1.ffi = s2.ffi ∧ r1 = r2
    | (Rerr (Rraise v48),Rerr (Rabort Rtype_error)) =>
      s1.ffi = s2.ffi ∧ r1 = r2
    | (Rerr (Rraise v48),Rerr (Rabort Rtimeout_error)) => k2 < k1
    | (Rerr (Rraise v48),Rerr (Rabort (Rffi_error v51))) =>
      s1.ffi = s2.ffi ∧ r1 = r2
    | (Rerr (Rabort Rtype_error),Rerr (Rabort Rtype_error)) =>
      s1.ffi = s2.ffi ∧ r1 = r2
    | (Rerr (Rabort Rtimeout_error),Rerr (Rabort Rtype_error)) => k1 < k2
    | (Rerr (Rabort (Rffi_error v56)),Rerr (Rabort Rtype_error)) =>
      s1.ffi = s2.ffi ∧ r1 = r2
    | (Rerr (Rabort Rtype_error),Rerr (Rabort Rtimeout_error)) => k2 < k1
    | (Rerr (Rabort Rtimeout_error),Rerr (Rabort Rtimeout_error)) => T
    | (Rerr (Rabort (Rffi_error v59)),Rerr (Rabort Rtimeout_error)) =>
      k2 < k1
    | (Rerr (Rabort Rtype_error),Rerr (Rabort (Rffi_error v54))) =>
      s1.ffi = s2.ffi ∧ r1 = r2
    | (Rerr (Rabort Rtimeout_error),Rerr (Rabort (Rffi_error v54))) =>
      k1 < k2
    | (Rerr (Rabort (Rffi_error v61)),Rerr (Rabort (Rffi_error v54))) =>
      s1.ffi = s2.ffi ∧ r1 = r2
