⊢ ∀P. (∀n x. P (Size n x)) ∧ (∀x v0 y. P x ∧ P y ⇒ P (Append x v0 y)) ∧
      (∀x. P x ⇒ P (Parenthesis x)) ∧ (∀v2. P (String v2)) ⇒
      ∀v. P v
KERNEL_THEOREM mlsexp.get_size_def
⊢ (∀x n. get_size (Size n x) = n) ∧
  (∀y x v0. get_size (Append x v0 y) = get_size x + get_size y + 1) ∧
  (∀x. get_size (Parenthesis x) = get_size x + 2) ∧
  ∀v2. get_size (String v2) = 0
KERNEL_THEOREM mlsexp.get_next_size_ind
⊢ ∀P. (∀n x. P (Size n x)) ∧ (∀x v0 y. P x ⇒ P (Append x v0 y)) ∧
      (∀x. P x ⇒ P (Parenthesis x)) ∧ (∀v2. P (String v2)) ⇒
      ∀v. P v
KERNEL_THEOREM mlsexp.get_next_size_def
⊢ (∀x n. get_next_size (Size n x) = n) ∧
  (∀y x v0. get_next_size (Append x v0 y) = get_next_size x) ∧
  (∀x. get_next_size (Parenthesis x) = get_next_size x + 2) ∧
  ∀v2. get_next_size (String v2) = 0
KERNEL_THEOREM mlsexp.fromString_sexp_to_string
⊢ fromString (sexp_to_string x) = SOME x
KERNEL_THEOREM mlsexp.fromString_sexp_to_pretty_string
⊢ fromString (sexp_to_pretty_string x) = SOME x
KERNEL_THEOREM mlsexp.flatten_acc
⊢ ∀x indent s. flatten indent x s = flatten indent x [] ++ s
KERNEL_THEOREM mlsexp.datatype_token
⊢ DATATYPE (token OPEN CLOSE SYMBOL)
KERNEL_THEOREM mlsexp.datatype_str_tree
⊢ DATATYPE (str_tree Str Trees GrabLine)
KERNEL_THEOREM mlsexp.datatype_sexp
⊢ DATATYPE (sexp Atom Expr)
KERNEL_THEOREM mlsexp.datatype_pretty
⊢ DATATYPE (pretty Parenthesis String Append Size)
