  ts = [Tapp [] Tword8array_num; Tapp [] Tint_num; Tapp [] Tword8_num] ∧
  t3 = Tapp [] Ttup_num ∨
  op = CopyStrStr ∧
  ts = [Tapp [] Tstring_num; Tapp [] Tint_num; Tapp [] Tint_num] ∧
  t3 = Tapp [] Tstring_num ∨
  op = CopyStrAw8 ∧
  ts =
  [Tapp [] Tstring_num; Tapp [] Tint_num; Tapp [] Tint_num;
   Tapp [] Tword8array_num; Tapp [] Tint_num] ∧ t3 = Tapp [] Ttup_num ∨
  op = CopyAw8Str ∧
  ts = [Tapp [] Tword8array_num; Tapp [] Tint_num; Tapp [] Tint_num] ∧
  t3 = Tapp [] Tstring_num ∨
  op = CopyAw8Aw8 ∧
  ts =
  [Tapp [] Tword8array_num; Tapp [] Tint_num; Tapp [] Tint_num;
   Tapp [] Tword8array_num; Tapp [] Tint_num] ∧ t3 = Tapp [] Ttup_num ∨
  op = Implode ∧ ts = [Tapp [Tapp [] Tchar_num] Tlist_num] ∧
  t3 = Tapp [] Tstring_num ∨
  op = Explode ∧ ts = [Tapp [] Tstring_num] ∧
  t3 = Tapp [Tapp [] Tchar_num] Tlist_num ∨
  op = Strsub ∧ ts = [Tapp [] Tstring_num; Tapp [] Tint_num] ∧
  t3 = Tapp [] Tchar_num ∨
  op = Strlen ∧ ts = [Tapp [] Tstring_num] ∧ t3 = Tapp [] Tint_num ∨
  op = Strcat ∧ ts = [Tapp [Tapp [] Tstring_num] Tlist_num] ∧
  t3 = Tapp [] Tstring_num ∨
  (∃t1'²¹'.
     op = VfromList ∧ ts = [Tapp [t1'²¹'] Tlist_num] ∧
     t3 = Tapp [t1'²¹'] Tvector_num) ∨
  op = Vsub ∧ ts = [Tapp [t3] Tvector_num; Tapp [] Tint_num] ∨
  (∃t1'²³'.
     op = Vlength ∧ ts = [Tapp [t1'²³'] Tvector_num] ∧ t3 = Tapp [] Tint_num) ∨
  (∃t2'¹³'.
     op = Aalloc ∧ ts = [Tapp [] Tint_num; t2'¹³'] ∧
     t3 = Tapp [t2'¹³'] Tarray_num) ∨
  (∃t2.
     op = AallocEmpty ∧ ts = [Tapp [] Ttup_num] ∧ t3 = Tapp [t2] Tarray_num) ∨
  op = Asub ∧ ts = [Tapp [t3] Tarray_num; Tapp [] Tint_num] ∨
  (∃t1'²⁷'.
     op = Alength ∧ ts = [Tapp [t1'²⁷'] Tarray_num] ∧ t3 = Tapp [] Tint_num) ∨
  (∃t3'⁵'.
     op = Aupdate ∧ ts = [Tapp [t3'⁵'] Tarray_num; Tapp [] Tint_num; t3'⁵'] ∧
