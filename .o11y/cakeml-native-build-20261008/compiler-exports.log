  ctors_of_dec (Denv v19) = []
KERNEL_THEOREM semanticPrimitivesProps.concrete_v_simps
⊢ (concrete_v (Litv l) ⇔ T) ∧ (concrete_v (Loc b n) ⇔ T) ∧
