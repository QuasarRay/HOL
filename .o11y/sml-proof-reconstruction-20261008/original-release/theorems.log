KERNEL_THEOREM Hol4SmlMacro.can_pmatch_all_fallback
⊢ can_pmatch_all c refs (ps ++ [Pany]) value ⇔ can_pmatch_all c refs ps value
KERNEL_THEOREM Hol4SmlMacro.evaluate_match_fallback
⊢ nsLookup env.v match_id = SOME match_value ⇒
  evaluate_match st env value (clauses ++ [(Pany,Raise (Var match_id))])
    bind_exn_v = evaluate_match st env value clauses match_value
KERNEL_THEOREM Hol4SmlMacro.lower_sml_match_correct
⊢ nsLookup env.v match_id = SOME match_value ⇒
  evaluate st env [lower_sml_match scrut clauses match_id] =
  sml_match_reference st env scrut clauses match_value
KERNEL_THEOREM Hol4SmlMacro.lower_sml_multifn_closure
⊢ evaluate st env [lower_sml_multifn arg clauses match_id] =
  (st,
   Rval
     [Closure env arg (lower_sml_match (Var (Short arg)) clauses match_id)])
KERNEL_THEOREM Hol4SmlMacro.lower_sml_multifn_application_correct
⊢ nsLookup env.v value_id = SOME value ∧
  nsLookup (nsBind arg value env.v) match_id = SOME match_value ⇒
  evaluate st env
    [lower_sml_multifn_application arg clauses match_id value_id] =
  if st.clock = 0 then (st,Rerr (Rabort Rtimeout_error))
  else
    sml_match_reference (dec_clock st) (env with v := nsBind arg value env.v)
      (Var (Short arg)) clauses match_value
KERNEL_THEOREM Hol4SmlMacro.lower_sml_sequence_correct
⊢ evaluate st env [Let NONE e1 e2] = sml_sequence_reference st env e1 e2
KERNEL_THEOREM Hol4SmlMacro.cakeml_function_equality
⊢ do_eq (Closure env1 arg1 body1) (Closure env2 arg2 body2) = Eq_val T
KERNEL_THEOREM Hol4SmlMacro.cakeml_empty_match_raises_bind
⊢ evaluate_match st env value [] bind_exn_v = (st,Rerr (Rraise bind_exn_v))
KERNEL_THEOREM Hol4SmlMacro.matched_body_bind_is_preserved
⊢ evaluate_match st env value
    [(Pany,Raise (Con (SOME (Short «Bind»)) []));
     (Pany,Raise (Var match_id))] bind_exn_v =
  evaluate_match st env value [(Pany,Raise (Con (SOME (Short «Bind»)) []))]
    match_value
KERNEL_THEOREM Hol4SmlApplication.literal_argument_binding_stable
⊢ argument_binding_stable st env temp (Lit literal)
KERNEL_THEOREM Hol4SmlApplication.variable_argument_binding_stable
⊢ name ≠ temp ⇒ argument_binding_stable st env temp (Var (Short name))
KERNEL_THEOREM Hol4SmlApplication.lower_sml_left_application_correct
⊢ fname ≠ aname ∧ argument_binding_stable st env fname aexp ⇒
  evaluate st env [lower_sml_left_application fname aname fexp aexp] =
  sml_left_application_reference st env fexp aexp
KERNEL_THEOREM Hol4SmlApplication.lowered_application_preserves_first_error
⊢ evaluate st env [fexp] = (s1,Rerr err) ⇒
  evaluate st env [lower_sml_left_application fname aname fexp aexp] =
  (s1,Rerr err)
KERNEL_THEOREM Hol4SmlApplication.application_order_is_observable
⊢ nsLookup env.v first_id = SOME first_value ∧
  nsLookup env.v second_id = SOME second_value ∧ first_value ≠ second_value ⇒
  evaluate st env
    [lower_sml_left_application fname aname (Raise (Var first_id))
       (Raise (Var second_id))] ≠
  evaluate st env [App Opapp [Raise (Var first_id); Raise (Var second_id)]]
KERNEL_THEOREM Hol4SmlApplication.temporary_capture_is_observable
⊢ 0 < st.clock ⇒
  evaluate st (temporary_capture_env closure_env)
    [lower_sml_left_application «argument» «operand» (Var (Short «function»))
       (Var (Short «argument»))] ≠
  sml_left_application_reference st (temporary_capture_env closure_env)
    (Var (Short «function»)) (Var (Short «argument»))
