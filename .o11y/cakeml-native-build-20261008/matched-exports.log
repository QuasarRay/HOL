KERNEL_THEOREM evaluateProps.evaluate_case_eqs
⊢ (pair_CASE p f = v ⇔ ∃x y. p = (x,y) ∧ f x y = v) ∧
  (result_CASE x f f1 = v ⇔
   (∃a. x = Rval a ∧ f a = v) ∨ ∃e. x = Rerr e ∧ f1 e = v) ∧
  (error_result_CASE x f f1 = v ⇔
   (∃a. x = Rraise a ∧ f a = v) ∨ ∃a. x = Rabort a ∧ f1 a = v) ∧
  ((if x then t1 else t2) = v ⇔ (x ⇔ T) ∧ t1 = v ∨ (x ⇔ F) ∧ t2 = v) ∧
  (option_CASE opt nc sc = v ⇔
   opt = NONE ∧ nc = v ∨ ∃x. opt = SOME x ∧ sc x = v) ∧
  (list_CASE x v f = v' ⇔ x = [] ∧ v = v' ∨ ∃a l. x = a::l ∧ f a l = v') ∧
  (exp_or_val_CASE x f f1 = v ⇔
   (∃e. x = Exp e ∧ f e = v) ∨ ∃v'. x = Val v' ∧ f1 v' = v) ∧
  (match_result_CASE x v v1 f = v' ⇔
