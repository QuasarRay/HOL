#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
SELF="$ROOT/tools/cakeml-hol4"
source "$SELF/hol4_artifacts.sh"
OUT="${HOL4_CAKEML_OUT:-$ROOT/.hol4-cakeml}"
HOLDIR="${HOLDIR:-$ROOT}"
: "${CAKEMLDIR:?CAKEMLDIR must point to a built CakeML checkout}"

usage() {
  cat <<USAGE
usage: tools/cakeml-hol4/cakeml-hol4 build [SML paths ...]

One-command fail-closed path:
  1. lexical preflight of selected source;
  2. concatenate the accepted CakeML source;
  3. invoke HOL4 on Hol4CakeCompileScript.sml;
  4. retain exact compiler-evaluation theorem/assembly identities.

The complete HOL4-SML semantic bridge remains OPEN.
USAGE
}

[[ ${1:-} == build ]] || { usage; exit 64; }
shift
(( $# )) || { echo "no SML inputs supplied" >&2; exit 64; }
mkdir -p "$OUT/lowered" "$OUT/proof"
rm -f "$OUT/proof/STATUS"
python3 "$SELF/macro_frontend.py" --root "$ROOT" --out "$OUT/lowered" "$@"

PROGRAM="$OUT/hol4.cml"
: > "$PROGRAM"
for f in "$@"; do
  cat "$OUT/lowered/$f" >> "$PROGRAM"
  printf '\n' >> "$PROGRAM"
done

export HOL4_CAKEML_PROGRAM_CML="$PROGRAM"
export HOL4_CAKEML_OUTPUT_ASM="$OUT/proof/hol4.S"
# Source is passed through the environment, so it is not a Holmake dependency.
# A fresh build directory prevents an old theorem from certifying new bytes.
WORK="$(mktemp -d "$OUT/proof/build-XXXXXXXX")"
cp "$SELF/formal/Hol4CakeCompileScript.sml" "$SELF/formal/Holmakefile" "$WORK/"
(
  cd "$WORK"
  "$HOLDIR/bin/Holmake" --qof --no-cache Hol4CakeCompileTheory.dat
)
for ext in dat sig sml; do
  cp "$(hol4_artifact_path "$WORK/Hol4CakeCompileTheory.$ext")" "$OUT/proof/"
done
test -s "$OUT/proof/hol4.S"
sha256sum "$PROGRAM" "$OUT/lowered/macro-manifest.json" "$OUT/proof/hol4.S" \
  > "$OUT/proof/SHA256SUMS"
printf '%s\n' "CHECKED_CAKEML_COMPILE_ONLY; HOL4-SML and machine/release semantic bridges OPEN" \
  > "$OUT/proof/STATUS"
